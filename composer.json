{
  "name": "debuss-a/piccolo-container",
  "type": "library",
  "description": "A PSR-11 dependency injection container with singleton, scoped and transient lifetimes, made for long-running PHP workers (FrankenPHP, RoadRunner, ...).",
  "license": "MIT",
  "keywords": [
    "psr-11",
    "container",
    "dependency injection",
    "autowiring",
    "scoped",
    "worker",
    "frankenphp"
  ],
  "authors": [
    {
      "name": "Alexandre Debusschère",
      "email": "alexandre.debusschere@hey.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Piccolo\\Container\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.4",
    "psr/container": "^2.0"
  },
  "require-dev": {
    "pestphp/pest": "^5.1",
    "phpstan/phpstan": "^2.1"
  },
  "provide": {
    "psr/container-implementation": "2.0"
  },
  "scripts": {
    "test": [
      "./vendor/bin/pest"
    ],
    "analyse": [
      "./vendor/bin/phpstan analyse --no-progress"
    ]
  },
  "extra": {
    "branch-alias": {
      "dev-master": "0.2.x-dev"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "sort-packages": true
  }
}
